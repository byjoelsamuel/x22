# x22 on your homelab — HTTPS with a mkcert certificate (see certs/README.md).
#
#   /          the x22 app (PWA)
#   /rest/*    → Navidrome (Subsonic API, same origin = no CORS, no mixed content)
#   /api/*     → x22 uploader
{
	# Clients that connect by IP send no SNI; serve the mkcert cert to them.
	default_sni {$SITE_NAME:192.168.0.100}
	# We bring our own certificate.
	auto_https disable_certs
}

https:// {
	tls /certs/cert.pem /certs/key.pem

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /rest/* {
		reverse_proxy {$NAVIDROME_UPSTREAM} {
			flush_interval -1 # stream audio as it arrives
		}
	}

	handle /api/* {
		request_body {
			max_size 4GB
		}
		reverse_proxy uploader:4600
	}

	handle {
		root * /srv
		@sw path /sw.js /registerSW.js /manifest.webmanifest /index.html
		header @sw Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

http:// {
	redir https://{host}:{$HTTPS_PORT:443}{uri} permanent
}
