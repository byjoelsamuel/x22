# Copy to .env and edit. Never commit .env.

# Your existing Navidrome, as reachable from the laptop.
NAVIDROME_URL=http://192.168.0.100:4533

# The host folder Navidrome scans (the same path you mounted into Navidrome).
MUSIC_DIR=/srv/music

# Owner of MUSIC_DIR (run `id` on the laptop). Uploads are written as this user.
PUID=1000
PGID=1000

# Name/IP in your certificate. Clients connecting by IP get this cert.
SITE_NAME=192.168.0.100

# Ports for Caddy. Change if 80/443 are taken on the laptop.
HTTPS_PORT=443
HTTP_PORT=80

# Optional: comma-separated Navidrome users allowed to upload (empty = any valid login).
ALLOWED_USERS=

# Largest single upload, in MB.
MAX_FILE_MB=2000

# Optional: free YouTube Data API key, used to read YouTube Music playlist links
# for Import → Playlists (titles only; nothing is downloaded). See README.
YOUTUBE_API_KEY=
