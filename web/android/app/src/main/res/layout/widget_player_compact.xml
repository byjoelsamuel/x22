<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow 1-row strip (e.g. 2×1, 3×1): cover · title / artist · ⏯ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_cover"
        android:maxWidth="64dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_cover_placeholder" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_idle_title"
            android:textColor="#F2F2F2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />
    </LinearLayout>


    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_play_bg"
        android:contentDescription="@string/action_play"
        android:src="@drawable/ic_widget_play_dark" />

</LinearLayout>
